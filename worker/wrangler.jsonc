  "triggers": {
    "crons": [
      "0 1 * * *"
    ]
  },
  "vars": {
    "SITE_ORIGIN": "https://duting51-create.github.io",
    "SPREADSHEET_TOKEN": "TnOCsqGGVhgjRyt5Jj3cV9FFnhg",
    "SHEET_ID": "e7d0c4",
    "GITHUB_REPO": "duting51-create/dudu-life-system",
    "GITHUB_BRANCH": "main"
  }
}
